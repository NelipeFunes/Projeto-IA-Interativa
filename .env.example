# Copie para .env (que fica fora do git) e preencha. O Vision nunca mostra esses valores.

# Orbit — use UM dos dois jeitos:
# 1) Token JWT: no Orbit logado, F12 → Application → Local Storage → chave "org-app:auth:token".
ORBIT_TOKEN=
# 2) E-mail e senha (o servidor faz login sozinho e renova o token).
ORBIT_EMAIL=
ORBIT_PASSWORD=

# Só se o endereço da API mudar:
# ORBIT_URL=https://orbit-fdzy.onrender.com

# Busca na web (opcional): crie a conta grátis em tavily.com e cole a chave (começa com tvly-).
# Sem ela, o Vision busca pelo DuckDuckGo.
TAVILY_API_KEY=
